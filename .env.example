# Neon 连接串
DATABASE_URL=
# 随机生成：openssl rand -base64 32
BETTER_AUTH_SECRET=
# 本地 http://localhost:5000，线上用 Vercel 域名
BETTER_AUTH_URL=
# 集成测试用的 Neon test branch（M3-2）。不能和 DATABASE_URL 是同一个库，测试会清空业务表
TEST_DATABASE_URL=
# dev 的主机名（只写主机名，不带用户名密码）。开发脚本只在 DATABASE_URL 是这个主机时才运行（scripts/dev-manual-edits.ts）
DEV_DATABASE_HOST=
# 小票识别（M6.7，tech-stack 11.3）：llm / none
RECEIPT_READER=
# OpenAI 兼容接口地址，Groq 是 https://api.groq.com/openai/v1。换服务商只改这几项
LLM_BASE_URL=
LLM_API_KEY=
# 看图模型，Groq 用 qwen/qwen3.8-27b
LLM_VISION_MODEL=
# 发邮件（M12，tech-stack 4）：专门发信的 Gmail 地址。不配时验证、重置密码邮件发不出去，其他功能照常
SMTP_USER=
# Gmail 应用专用密码（16 位，不带空格），不是登录密码
SMTP_PASS=
# 站长的 Hearth 登录邮箱，逗号分隔。只有他们能发 new_household 邀请码。不是 SMTP_USER
ADMIN_EMAILS=
# 每个家庭每月小票 LLM 识别次数，默认 50
RECEIPT_LLM_MONTHLY_LIMIT=
