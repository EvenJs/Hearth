# Neon 连接串
DATABASE_URL=
# 随机生成：openssl rand -base64 32
BETTER_AUTH_SECRET=
# 本地 http://localhost:5000，线上用 Vercel 域名
BETTER_AUTH_URL=
# 集成测试用的 Neon test branch（M3-2）。不能和 DATABASE_URL 是同一个库，测试会清空业务表
TEST_DATABASE_URL=
# dev 的主机名（只写主机名，不带用户名密码）。开发脚本只在 DATABASE_URL 是这个主机时才运行（scripts/dev-manual-edits.ts）
DEV_DATABASE_HOST=
# 小票识别（M6.7，tech-stack 11.3）：llm / text / none
RECEIPT_READER=
# OpenAI 兼容接口地址，Groq 是 https://api.groq.com/openai/v1。换服务商只改这几项
LLM_BASE_URL=
LLM_API_KEY=
# 看图模型，Groq 用 qwen/qwen3.8-27b
LLM_VISION_MODEL=
