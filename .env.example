# Neon 连接串
DATABASE_URL=
# 随机生成：openssl rand -base64 32
BETTER_AUTH_SECRET=
# 本地 http://localhost:5000，线上用 Vercel 域名
BETTER_AUTH_URL=
# 集成测试用的 Neon test branch（M3-2）。不能和 DATABASE_URL 是同一个库，测试会清空业务表
TEST_DATABASE_URL=
# dev 的主机名（只写主机名，不带用户名密码）。开发脚本只在 DATABASE_URL 是这个主机时才运行（scripts/dev-manual-edits.ts）
DEV_DATABASE_HOST=
